# Streamlit Cloud にデプロイする際は、
# このファイルの内容を Streamlit Cloud の "Secrets" 設定画面に貼り付けてください。
# このファイル自体は絶対にGitHubにアップしないでください！

# Supabase の接続URLをここに入力します
# （SupabaseダッシュボードのSettings > Database > Connection stringからコピー）
DATABASE_URL = "postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
